<!doctype html>
<html lang="en">
  <head>
    <title>{{ title or metadata.title }}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description or metadata.description }}">
    <meta property="og:url" content="{{ metadata.url }}"/>
    <meta property="og:type" content="website"/>
    <meta property="og:title" content="{{ title or metadata.title }}"/>
    <meta property="og:description" content="{{ description or metadata.description }}"/>
    <meta property="og:image" content="{{ ogImageUrl or metadata.ogp.ogImageUrl }}"/>
    <meta name="twitter:card" content="{{ metadata.ogp.twitterCard }}" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon/favicon-16x16.png">
    <link rel="manifest" href="/img/favicon/site.webmanifest">
    <link rel="mask-icon" href="/img/favicon/safari-pinned-tab.svg" color="#161016">
    <link rel="shortcut icon" href="/img/favicon/favicon.ico">
    <meta name="msapplication-TileColor" content="#161016">
    <meta name="msapplication-config" content="/img/favicon/browserconfig.xml">
    <meta name="theme-color" content="#E6ECE6">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/instantsearch.css@8.25.1/themes/reset-min.css" integrity="sha384-A9ULrFQpmriL2m1Pn90nelPpjTE18LrYTVsJmEiEnzyBvAH8rCwX/ZFC+ZO+EwON" crossorigin="anonymous">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700&family=Overpass+Mono:wght@400;700&family=Overpass:wght@600;900&display=swap" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ '/css/index.css' | url }}">
    <link rel="stylesheet" href="{{ '/css/prism.css' | url }}">
    <script src="https://cdn.jsdelivr.net/npm/algoliasearch@5.61.0/dist/lite/builds/browser.umd.js" integrity="sha384-EVcO/TbJvGp+3A66pdDzNRH3hJzmL0DECh0vg5sB2Su8up74gdbMjx1JANeFFfJC" crossorigin="anonymous" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/instantsearch.js@4.122.0/dist/instantsearch.production.min.js" integrity="sha384-daVUlTyPUz1ZJJmVc2G0xZ0dwNd43Qyiq8t18BoeqIjv8Xt4aRCFJ/vcMzXgg0PB" crossorigin="anonymous" defer></script>
    <script src="{{ '/js/index.js' | url }}" defer></script>
  </head>
  <body {% if templateClass %} class="{{ templateClass }} takanorip-blogBase"{% endif %}>
    <header class="takanorip-header">
      <h1 class="takanorip-headerLogo"><a class="takanorip-headerLogoLink" href="{{ '/' | url }}">takanorip blog</a></h1>
      <nav class="takanorip-nav">
        <ul class="takanorip-headerList">
            <li class="takanorip-headerItem">
              <a class="takanorip-headerLink" href="{{ '/' | url }}">portfolio</a>
            </li>
            <li class="takanorip-headerItem">
              <a class="takanorip-headerLink" href="{{ '/feed.xml' | url }}">rss</a>
            </li>
            <li class="takanorip-headerItem">
              <a class="takanorip-headerLink search" href="{{ '/search/' | url }}">search</a>
            </li>
          </ul>
      </nav>
    </header>
    <main class="takanorip-contents">
      {{ content | safe }}
    </main>
    <footer class="takanorip-blogFooter">
      <div class="takanorip-blogFooterContents">
        <p class="takanorip-blogFooterName">takanorip</p>
        <a href="{{ metadata.twitter }}">Twitter</a>
      </div>
      <p class="takanorip-blogFooterTop"><a href="#top">back to top</a></p>
    </footer>
  </body>
</html>
